# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# Never commit the real secrets.toml.

GEMINI_API_KEY = "paste-your-google-ai-studio-key-here"

# Neon Postgres connection string. Omit locally to use a SQLite file.
DATABASE_URL = "postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional overrides
# LLM_MODEL = "gemini-3.6-flash"   # stable Flash model as of Nov 2026
